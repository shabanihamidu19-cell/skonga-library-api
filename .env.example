# SKONGA Library API — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git. Only .env.example is committed.

# ── Application ──────────────────────────────────────────────────────────��[...]
ENVIRONMENT=development       # "production" on Render

# ── Database ───────────────────────────────────────────────────────────��[...]
# Supabase: Settings → Database → Connection string → URI (Transaction mode)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Security ───────────────────────────────────────────────────────────�[...]
# SHA-256 hash of your service token.
# Generate the token:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Then hash it:
#   python3 -c "import hashlib; print(hashlib.sha256(b'YOUR_TOKEN_HERE').hexdigest())"
# Store the HASH here, give the actual TOKEN to the SKONGA AI backend only.
SERVICE_TOKEN_HASH=c2dba365c12461c8192bffce256423f99343cd300a27518a6d3e283236b78cba

# ── Cache (optional) ─────────────────────────────────────────────────────
# Leave empty to run without caching (safe for Phase 1).
REDIS_URL=

# ── Logging ───────────────────────────────────────────────────────────��[...]
LOG_LEVEL=info    # debug | info | warning | error
